    "표지판에 적힌 일본어 글자를 크게 보여 드려요. 글자 모양만 맞춰 보세요": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Japonské znaky z cedulí zobrazujeme velké. Stačí porovnat jejich tvar"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi viser de japanske tegn på skiltene stort. Du skal bare sammenligne formerne"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir zeigen die japanischen Schriftzeichen von den Schildern groß an. Vergleiche einfach die Formen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εμφανίζουμε μεγάλους τους ιαπωνικούς χαρακτήρες των πινακίδων. Αρκεί να ταιριάξετε τα σχήματα"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We show the Japanese characters on signs in large type. Just match the shapes"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "We show the Japanese characters on signs in large type. Just match the shapes"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostramos en grande los caracteres japoneses de los carteles. Solo tienes que comparar las formas"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näytämme kylteissä olevat japanilaiset merkit isoina. Riittää, että vertaat muotoja"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous affichons en grand les caractères japonais des panneaux. Il suffit d’en comparer les formes"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kami menampilkan huruf Jepang pada papan petunjuk dalam ukuran besar. Cukup cocokkan bentuknya"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostriamo in grande i caratteri giapponesi dei cartelli. Basta confrontarne la forma"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "案内板に書かれた日本語の文字を大きく表示します。文字の形を見比べてください"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi viser de japanske tegnene på skiltene stort. Du trenger bare å sammenligne formene"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "We tonen de Japanse tekens op de borden groot. Vergelijk gewoon de vormen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Japońskie znaki z tablic pokazujemy dużym drukiem. Wystarczy dopasować kształty"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostramos em tamanho grande os caracteres japoneses das placas. Basta comparar o formato"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мы показываем японские иероглифы с указателей крупно. Просто сравните их форму"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi visar de japanska tecknen på skyltarna stort. Du behöver bara jämföra formerna"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เราแสดงตัวอักษรญี่ปุ่นบนป้ายเป็นตัวใหญ่ แค่เทียบรูปทรงตัวอักษรก็พอ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tabelalardaki Japonca karakterleri büyük gösteriyoruz. Şekilleri eşleştirmeniz yeterli"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chúng tôi hiển thị to các chữ tiếng Nhật trên biển chỉ dẫn. Bạn chỉ cần so hình dạng chữ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我们会把指示牌上的日文大字显示出来，对照字形即可"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我們會把指示牌上的日文大字顯示出來，對照字形即可"
          }
        }
      }
    },
