    "열차 앞의 행선지나 전광판을 비춰 주세요": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Namiřte na cíl na čele vlaku nebo na odjezdovou tabuli"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ret kameraet mod destinationen på togets front eller afgangstavlen"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Richte die Kamera auf das Fahrtziel an der Zugfront oder auf die Anzeigetafel"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Στρέψτε την κάμερα στον προορισμό στο μέτωπο του τρένου ή στον πίνακα αναχωρήσεων"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Point at the destination on the train front or on a departure board"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Point at the destination on the front of the train or on a departure board"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apunta al destino en la parte delantera del tren o al panel de salidas"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Suuntaa kamera junan keulassa tai lähtötaululla olevaan määränpäähän"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pointez vers la destination à l’avant du train ou vers le panneau d’affichage"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Arahkan ke tujuan di bagian depan kereta atau papan keberangkatan"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inquadra la destinazione sulla parte anteriore del treno o sul tabellone"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "列車前面の行き先か電光掲示板にカメラを向けてください"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Pek mot destinasjonen på fronten av toget eller på avgangstavlen"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Richt op de bestemming aan de voorkant van de trein of op het vertrekbord"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Skieruj aparat na stację docelową na przodzie pociągu lub na tablicę odjazdów"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aponte para o destino na frente do trem ou para o painel de partidas"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Наведите камеру на пункт назначения на поезде или на табло"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Rikta kameran mot destinationen på tågets front eller avgångstavlan"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ชี้กล้องไปที่ปลายทางหน้ารถไฟหรือป้ายแสดงเวลา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamerayı trenin önündeki hedefe veya kalkış tabelasına doğrultun"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy hướng camera vào điểm đến ở đầu tàu hoặc bảng điện tử"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请对准列车车头的终点站显示或电子显示屏"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請對準列車車頭的終點站顯示或電子看板"
          }
        }
      }
    },
