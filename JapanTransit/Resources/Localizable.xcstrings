    "승강장에서 카메라로 열차 확인": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zkontrolujte vlak fotoaparátem na nástupišti"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tjek toget med kameraet på perronen"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zug am Bahnsteig mit der Kamera prüfen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ελέγξτε το τρένο με την κάμερα στην αποβάθρα"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the train with the camera on the platform"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the train with the camera on the platform"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba el tren con la cámara en el andén"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarkista juna kameralla laiturilla"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez le train avec l’appareil photo sur le quai"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Periksa kereta dengan kamera di peron"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla il treno con la fotocamera sul binario"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホームでカメラを使って列車を確認"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sjekk toget med kameraet på plattformen"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Controleer de trein met de camera op het perron"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprawdź pociąg aparatem na peronie"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Confira o trem com a câmera na plataforma"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверьте поезд камерой на платформе"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrollera tåget med kameran på perrongen"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้กล้องตรวจสอบรถไฟที่ชานชาลา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Peronda kamerayla treni kontrol edin"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dùng camera kiểm tra tàu trên sân ga"
          }
        },
        "zh-Hans": {
