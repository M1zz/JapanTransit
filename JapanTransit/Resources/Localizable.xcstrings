    "모르겠으면 各駅停車(각역정차) 또는 各停 이라고 적힌 열차를 타세요": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když si nejste jistí, nastupte do vlaku s nápisem 各駅停車 (staví všude) nebo 各停"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Er du i tvivl, så tag et tog mærket 各駅停車 (stopper overalt) eller 各停"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Zweifel nimm einen Zug mit der Aufschrift 各駅停車 (hält überall) oder 各停"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αν δεν είστε σίγουροι, πάρτε τρένο με την ένδειξη 各駅停車 (σταματά παντού) ή 各停"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If unsure, take a train marked 各駅停車 (all stops) or 各停"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "If in doubt, take a train marked 各駅停車 (all stations) or 各停"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si no estás seguro, sube a un tren que ponga 各駅停車 (todas las paradas) o 各停"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jos olet epävarma, valitse juna, jossa lukee 各駅停車 (pysähtyy kaikilla) tai 各停"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En cas de doute, prenez un train marqué 各駅停車 (omnibus) ou 各停"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika ragu, naiklah kereta yang bertuliskan 各駅停車 (berhenti di semua stasiun) atau 各停"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se hai dubbi, sali su un treno con scritto 各駅停車 (ferma ovunque) o 各停"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "迷ったら「各駅停車」または「各停」と書かれた列車に乗ってください"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Er du usikker, ta et tog merket 各駅停車 (stopper overalt) eller 各停"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twijfel je, neem dan een trein met 各駅停車 (stopt overal) of 各停"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli nie jesteś pewien, wsiądź do pociągu z napisem 各駅停車 (staje wszędzie) lub 各停"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Na dúvida, pegue um trem marcado com 各駅停車 (para em todas) ou 各停"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если не уверены, садитесь на поезд с надписью 各駅停車 (все станции) или 各停"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Är du osäker, ta ett tåg märkt 各駅停車 (stannar överallt) eller 各停"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถ้าไม่แน่ใจ ให้ขึ้นรถที่เขียนว่า 各駅停車 (จอดทุกสถานี) หรือ 各停"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Emin değilseniz üzerinde 各駅停車 (her istasyonda durur) veya 各停 yazan trene binin"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu không chắc, hãy lên tàu ghi 各駅停車 (dừng mọi ga) hoặc 各停"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不确定时，请乘坐标有“各駅停車”或“各停”的列车"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不確定時，請搭乘標有「各駅停車」或「各停」的列車"
          }
        }
      }
    },
