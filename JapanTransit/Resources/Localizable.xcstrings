    "%@에서 %@로 회사가 바뀌어요. 개찰구를 한 번 더 지나고 요금이 따로 붙어요. 교통카드(Suica·PASMO)는 그대로 찍으면 돼요": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopravce se mění z %1$@ na %2$@. Projdete dalšími turnikety a zaplatíte zvláštní jízdné. Dopravní kartu (Suica nebo PASMO) přiložte jako obvykle"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Operatøren skifter fra %1$@ til %2$@. Du går gennem endnu en billetspærring og betaler en særskilt billetpris. Brug dit rejsekort (Suica eller PASMO) som sædvanligt"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Unternehmen wechselt von %1$@ zu %2$@. Du gehst noch einmal durch eine Sperre und zahlst einen separaten Fahrpreis. Halte deine Karte (Suica oder PASMO) wie gewohnt an das Lesegerät"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο φορέας αλλάζει από %1$@ σε %2$@. Θα περάσετε από ακόμη ένα turnstile και θα πληρώσετε ξεχωριστό ναύλο. Περάστε την κάρτα μετακίνησης (Suica ή PASMO) κανονικά"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The operator changes from %1$@ to %2$@. You'll pass through another ticket gate and pay a separate fare. Tap your transit card (Suica or PASMO) as usual"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The operator changes from %1$@ to %2$@. You'll go through another ticket barrier and pay a separate fare. Touch in with your travel card (Suica or PASMO) as usual"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambias de %1$@ a %2$@. Pasarás por otros tornos y pagarás una tarifa aparte. Pasa la tarjeta de transporte (Suica o PASMO) como siempre"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Liikennöitsijä vaihtuu: %1$@ → %2$@. Kuljet vielä yhden lippuportin läpi ja maksat erillisen lipun. Käytä matkakorttia (Suica tai PASMO) kuten tavallisesti"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La compagnie change de %1$@ à %2$@. Vous passerez de nouveaux portiques et paierez un tarif séparé. Utilisez votre carte de transport (Suica ou PASMO) comme d’habitude"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Operator berganti dari %1$@ ke %2$@. Anda akan melewati gerbang tiket lagi dan membayar tarif terpisah. Tempelkan kartu transportasi (Suica atau PASMO) seperti biasa"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La compagnia cambia da %1$@ a %2$@. Passerai da altri tornelli e pagherai una tariffa a parte. Usa la carta per i trasporti (Suica o PASMO) come sempre"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@から%2$@へ運営会社が変わります。改札をもう一度通り、運賃は別にかかります。交通系ICカード（Suica・PASMO）はそのままタッチすれば使えます"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Operatøren skifter fra %1$@ til %2$@. Du går gjennom enda en billettport og betaler en egen billettpris. Bruk reisekortet (Suica eller PASMO) som vanlig"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De vervoerder wisselt van %1$@ naar %2$@. Je gaat door nog een poortje en betaalt een apart tarief. Check in met je ov-kaart (Suica of PASMO) zoals gewoonlijk"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przewoźnik zmienia się z %1$@ na %2$@. Przejdziesz przez kolejne bramki i zapłacisz osobną opłatę. Kartę przejazdową (Suica lub PASMO) przykładaj jak zwykle"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A operadora muda de %1$@ para %2$@. Você passará por outra catraca e pagará uma tarifa separada. Use o cartão de transporte (Suica ou PASMO) normalmente"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перевозчик меняется: %1$@ → %2$@. Вам придётся пройти ещё одни турникеты и оплатить проезд отдельно. Карту (Suica или PASMO) прикладывайте как обычно"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Trafikoperatören byts från %1$@ till %2$@. Du går genom ytterligare en spärr och betalar en separat avgift. Använd resekortet (Suica eller PASMO) som vanligt"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ผู้ให้บริการเปลี่ยนจาก %1$@ เป็น %2$@ คุณต้องผ่านประตูตรวจตั๋วอีกครั้งและจ่ายค่าโดยสารแยกต่างหาก แตะบัตรโดยสาร (Suica หรือ PASMO) ได้ตามปกติ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İşletmeci %1$@ firmasından %2$@ firmasına değişiyor. Bir turnikeden daha geçecek ve ayrı ücret ödeyeceksiniz. Ulaşım kartınızı (Suica veya PASMO) her zamanki gibi okutun"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Công ty vận hành đổi từ %1$@ sang %2$@. Bạn sẽ qua thêm một cổng soát vé và trả giá vé riêng. Quẹt thẻ giao thông (Suica hoặc PASMO) như bình thường"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "运营公司将由%1$@换为%2$@。需要再过一次检票口，并另外收费。交通卡（Suica、PASMO）照常刷卡即可"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "營運公司將由%1$@換成%2$@。需要再過一次剪票口，並另外收費。交通卡（Suica、PASMO）照常刷卡即可"
          }
        }
      }
    },
