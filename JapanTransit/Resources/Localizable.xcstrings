    "같은 %@이지만 이 역에서 열차가 끝나요. 내려서 %@ 열차로 바꿔 타세요": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Je to stejná linka (%1$@), ale vlak v této stanici končí. Vystupte a přestupte na vlak směr %2$@"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det er samme linje (%1$@), men toget ender på denne station. Stig af og tag et tog mod %2$@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es ist dieselbe Linie (%1$@), aber der Zug endet an dieser Station. Steig aus und nimm einen Zug nach %2$@"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Είναι η ίδια γραμμή (%1$@), αλλά το τρένο τερματίζει σε αυτόν τον σταθμό. Κατεβείτε και πάρτε τρένο προς %2$@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's the same %1$@, but the train ends at this station. Get off and take a train for %2$@"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "It's the same %1$@, but the train terminates at this station. Get off and take a train for %2$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es la misma línea (%1$@), pero el tren termina en esta estación. Bájate y sube a un tren con destino %2$@"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Linja on sama (%1$@), mutta juna päättyy tälle asemalle. Jää pois ja vaihda junaan, joka menee kohteeseen %2$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C’est la même ligne (%1$@), mais le train termine son trajet à cette gare. Descendez et prenez un train à destination de %2$@"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jalurnya sama (%1$@), tetapi kereta berakhir di stasiun ini. Turun dan ganti ke kereta tujuan %2$@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È la stessa linea (%1$@), ma il treno termina a questa stazione. Scendi e prendi un treno per %2$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じ%1$@ですが、この駅で列車は終点です。降りて%2$@行きの列車に乗り換えてください"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det er samme linje (%1$@), men toget ender på denne stasjonen. Gå av og ta et tog mot %2$@"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het is dezelfde lijn (%1$@), maar de trein eindigt op dit station. Stap uit en neem een trein richting %2$@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To ta sama linia (%1$@), ale pociąg kończy bieg na tej stacji. Wysiądź i przesiądź się do pociągu w kierunku %2$@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "É a mesma linha (%1$@), mas o trem termina nesta estação. Desça e pegue um trem com destino a %2$@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Линия та же (%1$@), но здесь поезд заканчивает маршрут. Выйдите и пересядьте на поезд до %2$@"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det är samma linje (%1$@), men tåget slutar vid den här stationen. Kliv av och ta ett tåg mot %2$@"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เป็นสาย %1$@ เหมือนเดิม แต่รถไฟสิ้นสุดที่สถานีนี้ ให้ลงแล้วเปลี่ยนไปขึ้นรถไฟที่ไปทาง %2$@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hat aynı (%1$@), ama tren bu istasyonda sona eriyor. İnip %2$@ yönüne giden trene geçin"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vẫn là tuyến %1$@, nhưng tàu kết thúc ở ga này. Hãy xuống và đổi sang tàu đi %2$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "虽然是同一条%1$@，但列车到这一站就结束了。请下车，换乘开往%2$@的列车"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "雖然是同一條%1$@，但列車到這一站就結束了。請下車，改搭開往%2$@的列車"
          }
        }
      }
    },
