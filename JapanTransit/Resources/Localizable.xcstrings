    "지정석 유료 열차라 일반 표로는 못 타요": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vlak s příplatkem za místenku: s běžnou jízdenkou nelze jet"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tog med tillæg for reserveret plads: gælder ikke med almindelig billet"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zug mit Aufpreis für reservierte Plätze: mit einem normalen Ticket nicht nutzbar"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τρένο με επιβάρυνση κράτησης θέσης: δεν ισχύει με απλό εισιτήριο"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reserved-seat surcharge train: not valid with a regular ticket"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Reserved-seat supplement train: not valid with an ordinary ticket"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tren con suplemento de asiento reservado: no vale con un billete normal"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Paikkavarauksen lisämaksullinen juna: ei kelpaa tavallisella lipulla"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Train avec supplément place réservée : non valable avec un billet ordinaire"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kereta dengan biaya tambahan kursi reservasi: tidak bisa dinaiki dengan tiket biasa"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Treno con supplemento per posto riservato: non valido con un biglietto ordinario"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "指定席料金が必要な列車のため、普通乗車券では乗れません"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tog med tillegg for reservert plass: gjelder ikke med vanlig billett"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trein met toeslag voor gereserveerde plaats: niet geldig met een gewoon kaartje"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pociąg z dopłatą za miejscówkę: nie obowiązuje zwykły bilet"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Trem com taxa de assento reservado: não vale com bilhete comum"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поезд с платным местом: по обычному билету не проехать"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tåg med tillägg för reserverad plats: gäller inte med vanlig biljett"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รถไฟที่ต้องจ่ายค่าที่นั่งสำรอง ใช้ตั๋วธรรมดาขึ้นไม่ได้"
          }
        },
        "tr": {
          "stringUnit": {
