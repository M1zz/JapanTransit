    "개찰구를 나와 길을 걸어서 %@(%@)역으로 가요. 역 밖으로 나가는 게 맞아요": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Projděte turnikety a dojděte pěšky do stanice %1$@ (%2$@). Opustit stanici je správně"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gå ud gennem billetspærringen og gå til %1$@ (%2$@) station. Det er rigtigt at forlade stationen"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geh durch die Sperre und zu Fuß zur Station %1$@ (%2$@). Es ist richtig, den Bahnhof zu verlassen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Βγείτε από τα turnstiles και περπατήστε μέχρι τον σταθμό %1$@ (%2$@). Η έξοδος από τον σταθμό είναι σωστή"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Exit the ticket gates and walk to %1$@ (%2$@) Station. Leaving the station is correct"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Leave through the ticket barriers and walk to %1$@ (%2$@) station. Leaving the station is correct"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sal por los tornos y ve andando a la estación de %1$@ (%2$@). Es correcto salir de la estación"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Poistu lippuporteista ja kävele asemalle %1$@ (%2$@). Aseman ulkopuolelle meneminen on oikein"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Passez les portiques et rejoignez à pied la gare de %1$@ (%2$@). Il faut bien sortir de la gare"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Keluar dari gerbang tiket lalu jalan kaki ke Stasiun %1$@ (%2$@). Keluar dari stasiun memang benar"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esci dai tornelli e raggiungi a piedi la stazione di %1$@ (%2$@). Uscire dalla stazione è corretto"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "改札を出て、歩いて%1$@（%2$@）駅へ向かいます。駅の外に出るのが正しいです"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gå ut gjennom billettportene og gå til %1$@ (%2$@) stasjon. Det er riktig å forlate stasjonen"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ga door de poortjes naar buiten en loop naar station %1$@ (%2$@). Het station verlaten is juist"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyjdź przez bramki i dojdź pieszo do stacji %1$@ (%2$@). Wyjście ze stacji jest prawidłowe"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Saia pelas catracas e vá a pé até a estação %1$@ (%2$@). Sair da estação é o caminho certo"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выйдите через турникеты и дойдите пешком до станции %1$@ (%2$@). Выходить из станции действительно нужно"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Gå ut genom spärrarna och gå till %1$@ (%2$@) station. Det är rätt att lämna stationen"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ออกจากประตูตรวจตั๋วแล้วเดินไปสถานี %1$@ (%2$@) การออกนอกสถานีถูกต้องแล้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Turnikelerden çıkıp %1$@ (%2$@) istasyonuna yürüyün. İstasyondan çıkmak doğru"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ra khỏi cổng soát vé rồi đi bộ đến ga %1$@ (%2$@). Ra khỏi ga là đúng"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "出检票口，步行前往%1$@（%2$@）站。需要出站，没有错"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "出剪票口，步行前往%1$@（%2$@）站。需要出站，沒有錯"
          }
        }
      }
    },
