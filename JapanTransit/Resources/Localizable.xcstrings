    "다른 회사 노선으로 이어 달리는 열차는 행선지가 이렇게 나와요: %@": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vlaky, které pokračují po trati jiné společnosti, mají tyto cíle: %@"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tog, der kører videre på et andet selskabs bane, viser disse destinationer: %@"
          }
        },
        "de": {
          "stringUnit": {
