    "두 역은 가까워요. 개찰구를 나와 걸어서 가세요": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Obě stanice jsou blízko. Projděte turnikety a jděte pěšky"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "De to stationer ligger tæt på hinanden. Gå ud gennem billetspærringen og gå"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die beiden Stationen liegen nah beieinander. Geh durch die Sperre und zu Fuß weiter"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι δύο σταθμοί είναι κοντά. Βγείτε από τα turnstiles και περπατήστε"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The two stations are close. Exit the ticket gates and walk"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The two stations are close. Leave through the ticket barriers and walk"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las dos estaciones están cerca. Sal por los tornos y ve andando"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Asemat ovat lähellä toisiaan. Poistu lippuporteista ja kävele"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les deux gares sont proches. Passez les portiques et marchez"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kedua stasiun berdekatan. Keluar dari gerbang tiket lalu jalan kaki"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le due stazioni sono vicine. Esci dai tornelli e vai a piedi"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2つの駅は近くにあります。改札を出て歩いてください"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "De to stasjonene ligger tett. Gå ut gjennom billettportene og gå"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De twee stations liggen dicht bij elkaar. Ga door de poortjes naar buiten en loop"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stacje są blisko siebie. Wyjdź przez bramki i idź pieszo"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As duas estações são próximas. Saia pelas catracas e vá a pé"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Станции рядом. Выйдите через турникеты и идите пешком"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "De två stationerna ligger nära varandra. Gå ut genom spärrarna och gå"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สองสถานีอยู่ใกล้กัน ออกจากประตูตรวจตั๋วแล้วเดินไป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İki istasyon yakın. Turnikelerden çıkıp yürüyün"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai ga ở gần nhau. Ra khỏi cổng soát vé rồi đi bộ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两站很近。请出检票口步行前往"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "兩站很近。請出剪票口步行前往"
          }
        }
      }
    },
    "두 역은 역 안 통로로 이어져 있어요. 걸어서 가세요": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Obě stanice spojuje podzemní chodba. Jděte pěšky"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "De to stationer er forbundet af en gang under jorden. Gå dertil"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die beiden Stationen sind durch einen unterirdischen Gang verbunden. Geh zu Fuß"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι δύο σταθμοί συνδέονται με υπόγειο πέρασμα. Περπατήστε"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The two stations are connected by an underground passage. Walk there"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The two stations are linked by an underground passage. Walk there"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las dos estaciones se conectan por un pasillo subterráneo. Ve andando"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Asemat on yhdistetty maanalaisella käytävällä. Kävele perille"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les deux gares sont reliées par un passage souterrain. Rejoignez-la à pied"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kedua stasiun terhubung lorong di dalam stasiun. Silakan jalan kaki"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le due stazioni sono collegate da un passaggio sotterraneo. Vai a piedi"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2つの駅は駅構内の通路でつながっています。歩いて向かってください"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "De to stasjonene er forbundet med en gang under bakken. Gå dit"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De twee stations zijn verbonden door een ondergrondse gang. Loop erheen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stacje łączy podziemne przejście. Idź pieszo"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As duas estações são ligadas por uma passagem subterrânea. Vá a pé"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Станции соединены подземным переходом. Идите пешком"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "De två stationerna är förbundna med en gång under mark. Gå dit"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สองสถานีเชื่อมกันด้วยทางเดินในสถานี เดินไปได้เลย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İki istasyon yer altı geçidiyle bağlı. Yürüyerek gidin"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai ga nối với nhau bằng lối đi trong ga. Hãy đi bộ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两站之间有站内通道相连。请步行前往"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "兩站之間有站內通道相連。請步行前往"
          }
        }
      }
    },
