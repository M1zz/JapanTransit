    "승강장에서 카메라로 열차를 비추면 타도 되는지 알려 드려요": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Namiřte fotoaparát na vlak na nástupišti a řekneme vám, zda můžete nastoupit"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ret kameraet mod et tog på perronen, så fortæller vi, om du kan stige på"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Richte die Kamera am Bahnsteig auf einen Zug, und wir sagen dir, ob du einsteigen kannst"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Στρέψτε την κάμερα σε ένα τρένο στην αποβάθρα και θα σας πούμε αν μπορείτε να επιβιβαστείτε"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Point the camera at a train on the platform to see if you can board"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Point the camera at a train on the platform to see whether you can board"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apunta la cámara a un tren en el andén y te diremos si puedes subir"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Suuntaa kamera laiturilla olevaan junaan, niin kerromme, voitko nousta kyytiin"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pointez l’appareil photo vers un train sur le quai pour savoir si vous pouvez monter"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Arahkan kamera ke kereta di peron, dan kami beri tahu apakah boleh naik"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inquadra un treno sul binario e ti diremo se puoi salire"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホームでカメラを列車に向けると、乗ってよいかお知らせします"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Pek kameraet mot et tog på plattformen, så forteller vi om du kan gå på"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Richt de camera op een trein op het perron, dan laten we weten of je kunt instappen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Skieruj aparat na pociąg na peronie, a podpowiemy, czy możesz wsiąść"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aponte a câmera para um trem na plataforma e avisamos se pode embarcar"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Наведите камеру на поезд на платформе, и мы подскажем, можно ли садиться"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Rikta kameran mot ett tåg på perrongen, så berättar vi om du kan kliva på"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ชี้กล้องไปที่รถไฟบนชานชาลา แล้วเราจะบอกว่าขึ้นได้หรือไม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamerayı peronda bir trene doğrultun, binip binemeyeceğinizi söyleyelim"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hướng camera vào tàu trên sân ga, chúng tôi sẽ cho bạn biết có nên lên tàu không"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在站台用相机对准列车，即可告诉您能否乘坐"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在月台用相機對準列車，即可告訴您能否搭乘"
          }
        }
      }
    },
