          "stringUnit": {
            "state": "translated",
            "value": "Los trenes que continúan por la línea de otra compañía muestran estos destinos: %@"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Toisen yhtiön radalle jatkavien junien määränpäät näkyvät näin: %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
