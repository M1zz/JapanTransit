    "설정에서 위치 권한을 켜면 가까운 역을 찾아요": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapněte v Nastavení přístup k poloze a najdeme stanice poblíž"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå adgang til lokation til i Indstillinger for at finde stationer i nærheden"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere den Standortzugriff in den Einstellungen, um Stationen in der Nähe zu finden"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ενεργοποιήστε την πρόσβαση τοποθεσίας στις Ρυθμίσεις για να βρείτε κοντινούς σταθμούς"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on location access in Settings to find nearby stations"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch on location access in Settings to find nearby stations"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa el acceso a la ubicación en Ajustes para encontrar estaciones cercanas"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ota sijainnin käyttö käyttöön Asetuksissa, niin löydät lähellä olevat asemat"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez la localisation dans Réglages pour trouver les gares proches"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktifkan izin lokasi di Pengaturan untuk menemukan stasiun terdekat"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva la posizione in Impostazioni per trovare le stazioni vicine"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定で位置情報の許可をオンにすると、近くの駅を探せます"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå på tilgang til posisjon i Innstillinger for å finne stasjoner i nærheten"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet locatietoegang aan in Instellingen om stations in de buurt te vinden"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Włącz dostęp do lokalizacji w Ustawieniach, aby znaleźć pobliskie stacje"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative a localização em Ajustes para encontrar estações próximas"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите доступ к геопозиции в настройках, чтобы найти ближайшие станции"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå på platsåtkomst i Inställningar för att hitta stationer i närheten"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดการเข้าถึงตำแหน่งในการตั้งค่า เพื่อค้นหาสถานีใกล้เคียง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yakındaki istasyonları bulmak için Ayarlar’dan konum erişimini açın"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bật quyền truy cập vị trí trong Cài đặt để tìm các ga gần bạn"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在“设置”中开启定位权限，即可查找附近车站"
