    "회사가 바뀌어 요금이 따로 붙어요": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopravce se mění, proto se jízdné účtuje zvlášť"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Operatøren skifter, så billetprisen opkræves særskilt"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Unternehmen wechselt, daher wird der Fahrpreis separat berechnet"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο φορέας αλλάζει, γι’ αυτό το ναύλο χρεώνεται ξεχωριστά"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The operator changes, so fares are charged separately"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The operator changes, so fares are charged separately"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia la compañía, así que la tarifa se cobra aparte"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Liikennöitsijä vaihtuu, joten lippu maksetaan erikseen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La compagnie change : le tarif est facturé séparément"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Operator berganti, jadi tarif dibayar terpisah"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La compagnia cambia, quindi la tariffa è separata"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "運営会社が変わるため、運賃は別にかかります"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Operatøren skifter, så billettprisen betales separat"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De vervoerder wisselt, dus het tarief wordt apart berekend"
          }
        },
        "pl": {
