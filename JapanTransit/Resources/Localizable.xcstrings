    "%@ 열차는 %@에서 탈 수 없어요. 各停(각역정차)을 타세요": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vlak %1$@ nestaví ve stanici %2$@. Nastupte do vlaku 各停 (staví všude)"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@-toget stopper ikke ved %2$@. Tag et 各停-tog (stopper overalt)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Zug %1$@ hält nicht in %2$@. Nimm einen 各停-Zug (hält überall)"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το τρένο %1$@ δεν σταματά στο %2$@. Πάρτε τρένο 各停 (σταματά παντού)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The %1$@ train doesn't stop at %2$@. Take a 各停 (all stops) train"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The %1$@ train doesn't stop at %2$@. Take a 各停 (all stations) train"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El tren %1$@ no para en %2$@. Sube a un tren 各停 (todas las paradas)"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@-juna ei pysähdy asemalla %2$@. Valitse 各停-juna (pysähtyy kaikilla asemilla)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le train %1$@ ne s’arrête pas à %2$@. Prenez un train 各停 (omnibus)"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kereta %1$@ tidak berhenti di %2$@. Naiklah kereta 各停 (berhenti di semua stasiun)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il treno %1$@ non ferma a %2$@. Prendi un treno 各停 (ferma ovunque)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@の列車は%2$@には停まりません。各停にお乗りください"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@-toget stopper ikke ved %2$@. Ta et 各停-tog (stopper overalt)"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De trein %1$@ stopt niet in %2$@. Neem een 各停-trein (stopt overal)"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pociąg %1$@ nie zatrzymuje się na stacji %2$@. Wsiądź do pociągu 各停 (staje wszędzie)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O trem %1$@ não para em %2$@. Pegue um trem 各停 (para em todas)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поезд %1$@ не останавливается на станции %2$@. Садитесь на поезд 各停 (все станции)"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@-tåget stannar inte vid %2$@. Ta ett 各停-tåg (stannar överallt)"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รถไฟ %1$@ ไม่จอดที่ %2$@ ให้ขึ้นรถ 各停 (จอดทุกสถานี)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ treni %2$@ istasyonunda durmaz. 各停 (her istasyonda durur) trenine binin"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tàu %1$@ không dừng ở %2$@. Hãy lên tàu 各停 (dừng mọi ga)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@列车在%2$@不停靠。请乘坐“各停”（每站停车）列车"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@列車在%2$@不停靠。請搭乘「各停」（每站停車）列車"
          }
        }
      }
    },
